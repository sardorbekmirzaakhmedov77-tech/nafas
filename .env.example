# Copy to .env (or set these in your hosting dashboard).

# Required in production: a long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Optional. Defaults to a local SQLite file (nafas.db).
# DATABASE_URL=postgresql://user:password@host:5432/nafas

# 1 = generated sample data, no internet needed. 0 = live data from Open-Meteo.
DEMO_MODE=0

# Hourly refresh + alert checks. Turn off if you run them with cron instead.
ENABLE_SCHEDULER=1

# Email alerts (optional). Without MAIL_SERVER, emails are printed to the log.
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_FROM=Nafas <you@gmail.com>

# Used for links inside alert emails.
SITE_URL=http://localhost:5000
